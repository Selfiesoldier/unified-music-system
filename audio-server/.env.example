# Audio Server Port (different from Main Server, e.g. 8000)
PORT=8000

# Secret token required by Main Server for /api/* control endpoints
AUDIO_SECRET=supersecret_audio_key_123

# Bitrate for the persistent MP3 stream (e.g. 128k, 192k)
AUDIO_BITRATE=128k

# Optional: Path to custom FFmpeg binary (leave blank to auto-detect system or ffmpeg-static)
# FFMPEG_PATH=/usr/bin/ffmpeg
